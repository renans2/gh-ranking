# Copy to .env and fill in from Supabase: Project Settings > API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co

# Read-only key used by the website.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Write key used only by `npm run sync`. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Needed for the users ranking: GitHub's GraphQL API requires a token. Paste the output of
# `gh auth token`, or create a fine-grained token with no permissions (public data only).
GITHUB_TOKEN=
