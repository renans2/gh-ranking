---
import { Font } from 'astro:assets';
import PixelIcon from '../components/PixelIcon';
import { HEART } from '../utils/pixel-art';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<Font cssVariable="--font-press-start" preload />
		<Font cssVariable="--font-vt323" preload />
		<script is:inline>
			// Runs before first paint so the page never flashes the wrong theme.
			(() => {
				let theme;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body class="min-h-screen font-sans text-xl text-fg">
		<main class="mx-auto max-w-5xl px-4 py-10">
			<slot />
		</main>
		<footer class="flex items-center justify-center gap-2 px-4 pb-10 text-xl text-muted">
			made with
			<PixelIcon art={HEART} className="h-4 w-[18px] text-heart" />
			<span class="sr-only">love</span>
			by
			<a
				href="https://github.com/renans2"
				target="_blank"
				rel="noopener noreferrer"
				class="text-accent decoration-2 underline-offset-4 hover:underline">renans2</a
			>
		</footer>
	</body>
</html>
