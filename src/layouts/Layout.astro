---
import { Font } from 'astro:assets';
import PixelIcon from '../components/PixelIcon';
import SiteActions from '../components/SiteActions.astro';
import { AUTHOR, RANKING_PAGES, SITE_NAME } from '../constants/site';
import { HEART } from '../constants/sprites';
import { THEME_STORAGE_KEY } from '../constants/theme';
import '../styles/global.css';

interface Props {
	title: string;
	/**
	 * The bar with the site name, menu and buttons. Pages that turn it off place
	 * <SiteActions /> themselves, like the home page next to its title.
	 */
	siteHeader?: boolean;
}

const { title, siteHeader = true } = Astro.props;

const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · {SITE_NAME}</title>
		<Font cssVariable="--font-press-start" preload />
		<Font cssVariable="--font-vt323" preload />
		<script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
			// Runs before first paint so the page never flashes the wrong theme.
			let theme;
			try {
				theme = localStorage.getItem(storageKey);
			} catch {}
			if (theme !== 'light' && theme !== 'dark') {
				theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			document.documentElement.dataset.theme = theme;
		</script>
	</head>
	<body class="min-h-screen font-sans text-xl text-fg">
		{
			siteHeader && (
				<header class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 pt-8">
					<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-8">
						<a href="/" class="font-pixel text-xs text-muted hover:text-accent">{SITE_NAME}</a>
						<nav aria-label="Rankings" class="flex gap-5">
							{
								Object.values(RANKING_PAGES).map(({ href, label }) => (
									<a
										href={href}
										aria-current={path === href ? 'page' : undefined}
										class="font-pixel text-[10px] text-muted uppercase decoration-2 underline-offset-[6px] hover:text-accent aria-[current=page]:text-fg aria-[current=page]:underline"
									>
										{label}
									</a>
								))
							}
						</nav>
					</div>
					<SiteActions />
				</header>
			)
		}
		<main class:list={['mx-auto max-w-5xl px-4 pb-10', siteHeader ? 'pt-8' : 'pt-12']}>
			<slot />
		</main>
		<footer class="flex items-center justify-center gap-2 px-4 pb-10 text-xl text-muted">
			made with
			<PixelIcon art={HEART} className="h-4 w-[18px] text-heart" />
			<span class="sr-only">love</span>
			by
			<a
				href={AUTHOR.url}
				target="_blank"
				rel="noopener noreferrer"
				class="text-accent decoration-2 underline-offset-4 hover:underline">{AUTHOR.login}</a
			>
		</footer>
	</body>
</html>
