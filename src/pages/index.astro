---
import LeaderboardTable from '../components/LeaderboardTable.astro';
import Layout from '../layouts/Layout.astro';
import { getLeaderboard } from '../lib/leaderboard';

const rows = await getLeaderboard();
const snapshotDate = rows[0]?.snapshot_date;
const previousDate = rows[0]?.previous_date;
---

<Layout title="GitHub Star Ranking">
	<h1 class="mb-1 text-[1.75rem] font-bold">Most-starred GitHub repos</h1>
	{
		snapshotDate ? (
			<p class="mb-6 text-muted">
				Snapshot from {snapshotDate}
				{previousDate ? `, changes compared with ${previousDate}` : ', no earlier snapshot to compare with yet'}
			</p>
		) : (
			<p class="mb-6 text-muted">No snapshots yet. Run <code>npm run sync</code> to take the first one.</p>
		)
	}
	{rows.length > 0 && <LeaderboardTable rows={rows} />}
</Layout>
