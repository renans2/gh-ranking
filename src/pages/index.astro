---
import PageHeader from '../components/PageHeader.astro';
import PixelIcon from '../components/PixelIcon';
import { RANKING_PAGES } from '../constants/site';
import { ARROW_RIGHT, TROPHY } from '../constants/sprites';
import Layout from '../layouts/Layout.astro';

// No data on this page, so it's built once at deploy time instead of on every request.
---

<Layout title="GitHub Rankings">
	<PageHeader
		title="GitHub Rankings"
		icon={TROPHY}
		iconColor="text-star"
		status="daily snapshots of GitHub's top repos and users"
	/>
	<div class="grid gap-8 sm:grid-cols-2">
		{
			Object.values(RANKING_PAGES).map((page) => (
				<a
					href={page.href}
					class="group pixel-frame pixel-press flex flex-col gap-4 bg-surface p-6 hover:bg-hover"
				>
					<div class="flex items-center gap-4">
						<span class="pixel-frame grid size-14 shrink-0 place-items-center bg-canvas [--px:2px]">
							<PixelIcon art={page.icon} className={`size-9 ${page.iconColor}`} />
						</span>
						<h2 class="font-pixel text-sm leading-relaxed sm:text-base">{page.title}</h2>
					</div>
					<p class="text-xl leading-tight text-muted">{page.description}</p>
					<span class="mt-auto flex items-center gap-2 font-pixel text-[10px] text-accent uppercase">
						View ranking
						<PixelIcon
							art={ARROW_RIGHT}
							className="h-2.5 w-1.5 transition-transform group-hover:translate-x-1"
						/>
					</span>
				</a>
			))
		}
	</div>
</Layout>
