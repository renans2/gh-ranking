---
import LanguageFilter from '../components/LanguageFilter.astro';
import LeaderboardTable from '../components/LeaderboardTable.astro';
import PageHeader from '../components/PageHeader.astro';
import { STAR } from '../constants/sprites';
import Layout from '../layouts/Layout.astro';
import { getLeaderboard } from '../lib/leaderboard';
import { selectedLanguage } from '../utils/language-filter';

// Rendered on every request, so each visit reads the latest snapshot with one query.
export const prerender = false;

// All rows are rendered; ones outside ?language= start hidden, so the filter buttons
// can switch languages in the page without loading it again.
const rows = await getLeaderboard();
const language = selectedLanguage(Astro.url.searchParams);
---

<Layout title="GitHub Star Ranking">
	<PageHeader
		title="GitHub Star Ranking"
		icon={STAR}
		iconColor="text-star"
		snapshotDate={rows[0]?.snapshot_date}
		previousDate={rows[0]?.previous_date}
	/>
	{
		rows.length > 0 && (
			<>
				<LanguageFilter rows={rows} selected={language} />
				<LeaderboardTable rows={rows} language={language} />
			</>
		)
	}
</Layout>
