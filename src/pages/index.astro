---
import { supabase } from '../lib/supabase';

interface LeaderboardRow {
	rank: number;
	id: number;
	full_name: string;
	html_url: string;
	description: string | null;
	language: string | null;
	owner_avatar_url: string | null;
	stars: number;
	forks: number;
	snapshot_date: string;
	previous_date: string | null;
	stars_change: number | null;
	rank_change: number | null;
}

const { data, error } = await supabase.from('leaderboard').select('*').order('rank');
if (error) throw new Error(`Failed to load leaderboard: ${error.message}`);
const rows: LeaderboardRow[] = data;

const snapshotDate = rows[0]?.snapshot_date;
const previousDate = rows[0]?.previous_date;
const number = new Intl.NumberFormat('en-US');
const compact = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });

function rankLabel(row: LeaderboardRow) {
	if (!row.previous_date) return { text: '', kind: 'none' };
	if (row.rank_change === null) return { text: 'new', kind: 'new' };
	if (row.rank_change > 0) return { text: `▲ ${row.rank_change}`, kind: 'up' };
	if (row.rank_change < 0) return { text: `▼ ${-row.rank_change}`, kind: 'down' };
	return { text: '–', kind: 'same' };
}

function avatarUrl(url: string) {
	const avatar = new URL(url);
	avatar.searchParams.set('s', '48'); // 2x the displayed size
	return avatar.href;
}

function starsLabel(change: number | null) {
	if (change === null) return '';
	return change > 0 ? `+${number.format(change)}` : number.format(change);
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>GitHub Star Ranking</title>
	</head>
	<body>
		<main>
			<h1>Most-starred GitHub repos</h1>
			{
				snapshotDate ? (
					<p class="meta">
						Snapshot from {snapshotDate}
						{previousDate ? `, changes compared with ${previousDate}` : ', no earlier snapshot to compare with yet'}
					</p>
				) : (
					<p class="meta">No snapshots yet. Run <code>npm run sync</code> to take the first one.</p>
				)
			}
			{
				rows.length > 0 && (
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th class="num">#</th>
									<th>Repository</th>
									<th>Language</th>
									<th class="num">Stars</th>
									<th class="num">Change</th>
									<th class="num">Forks</th>
								</tr>
							</thead>
							<tbody>
								{rows.map((row) => {
									const rank = rankLabel(row);
									return (
										<tr>
											<td class="num">
												<span class="rank">{row.rank}</span>
												<span class:list={['rank-change', rank.kind]}>{rank.text}</span>
											</td>
											<td class="repo">
												<a href={row.html_url}>
													{row.owner_avatar_url && (
														<img src={avatarUrl(row.owner_avatar_url)} alt="" width="24" height="24" loading="lazy" />
													)}
													{row.full_name}
												</a>
												{row.description && <p>{row.description}</p>}
											</td>
											<td>{row.language ?? '—'}</td>
											<td class="num" title={number.format(row.stars)}>{compact.format(row.stars)}</td>
											<td class:list={['num', { up: (row.stars_change ?? 0) > 0, down: (row.stars_change ?? 0) < 0 }]}>
												{starsLabel(row.stars_change)}
											</td>
											<td class="num" title={number.format(row.forks)}>{compact.format(row.forks)}</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				)
			}
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--fg: #1f2328;
		--muted: #59636e;
		--border: #d1d9e0;
		--row-hover: #f6f8fa;
		--up: #1a7f37;
		--down: #cf222e;
		--accent: #0969da;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0d1117;
			--fg: #f0f6fc;
			--muted: #9198a1;
			--border: #3d444d;
			--row-hover: #151b23;
			--up: #3fb950;
			--down: #f85149;
			--accent: #4493f8;
		}
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
	}
</style>

<style>
	main {
		max-width: 64rem;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	h1 {
		margin: 0 0 0.25rem;
		font-size: 1.75rem;
	}
	.meta {
		margin: 0 0 1.5rem;
		color: var(--muted);
	}
	.table-wrap {
		overflow-x: auto;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th,
	td {
		padding: 0.625rem 0.75rem;
		border-bottom: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}
	th {
		color: var(--muted);
		font-weight: 600;
		white-space: nowrap;
	}
	tbody tr:hover {
		background: var(--row-hover);
	}
	.num {
		text-align: right;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.rank {
		font-weight: 600;
	}
	.rank-change {
		display: block;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.rank-change.new {
		color: var(--accent);
		text-transform: uppercase;
	}
	.up {
		color: var(--up);
	}
	.down {
		color: var(--down);
	}
	.repo a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}
	.repo a:hover {
		text-decoration: underline;
	}
	.repo img {
		border-radius: 50%;
	}
	.repo p {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
