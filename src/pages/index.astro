---
import LanguageFilter from '../components/LanguageFilter.astro';
import LeaderboardTable from '../components/LeaderboardTable.astro';
import PixelIcon from '../components/PixelIcon';
import ThemeToggle from '../components/ThemeToggle';
import Layout from '../layouts/Layout.astro';
import { getLeaderboard } from '../lib/leaderboard';
import { selectedLanguage } from '../utils/language-filter';
import { STAR } from '../utils/pixel-art';

// Rendered on every request, so each visit reads the latest snapshot with one query.
export const prerender = false;

// All rows are rendered; ones outside ?language= start hidden, so the filter buttons
// can switch languages in the page without loading it again.
const rows = await getLeaderboard();
const language = selectedLanguage(Astro.url.searchParams);

const snapshotDate = rows[0]?.snapshot_date;
const previousDate = rows[0]?.previous_date;

let status = 'no snapshots yet, run `npm run sync` to take the first one';
if (snapshotDate) {
	status = previousDate
		? `snapshot ${snapshotDate}, compared with ${previousDate}`
		: `snapshot ${snapshotDate}, nothing earlier to compare with yet`;
}
---

<Layout title="GitHub Star Ranking">
	<header class="mb-10 flex items-start justify-between gap-4">
		<div>
			<h1
				class="flex items-center gap-3 font-pixel text-base leading-normal [text-shadow:3px_3px_0_var(--drop)] sm:gap-4 sm:text-2xl"
			>
				<PixelIcon art={STAR} className="size-[18px] shrink-0 text-star sm:size-[27px]" />
				GitHub Star Ranking
			</h1>
			<p class="mt-3 text-xl text-muted">
				&gt; {status}<span
					class="ml-1 inline-block h-[1em] w-[0.5em] translate-y-[0.15em] bg-muted motion-safe:animate-blink"
				></span>
			</p>
		</div>
		<ThemeToggle client:load />
	</header>
	{
		rows.length > 0 && (
			<>
				<LanguageFilter rows={rows} selected={language} />
				<LeaderboardTable rows={rows} language={language} />
			</>
		)
	}
</Layout>
