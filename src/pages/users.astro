---
import PageHeader from '../components/PageHeader.astro';
import UserLeaderboardTable from '../components/UserLeaderboardTable.astro';
import { RANKING_PAGES } from '../constants/site';
import Layout from '../layouts/Layout.astro';
import { getUserLeaderboard } from '../lib/leaderboard';
import { snapshotStatus } from '../utils/format';

// Rendered on every request, so each visit reads the latest snapshot with one query.
export const prerender = false;

const rows = await getUserLeaderboard();
const page = RANKING_PAGES.users;
---

<Layout title={page.title}>
	<PageHeader title={page.title} icon={page.icon} iconColor={page.iconColor} status={snapshotStatus(rows[0])} />
	{rows.length > 0 && <UserLeaderboardTable rows={rows} />}
</Layout>
