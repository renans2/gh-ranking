---
import PixelIcon from './PixelIcon';

interface Props {
	title: string;
	/** Pixel-art sprite shown before the title, and its text color class. */
	icon: readonly string[];
	iconColor: string;
	/** The leaderboard's latest snapshot day and the day it's compared with. */
	snapshotDate?: string;
	previousDate?: string | null;
}

const { title, icon, iconColor, snapshotDate, previousDate } = Astro.props;

let status = 'no snapshots yet, run `npm run sync` to take the first one';
if (snapshotDate) {
	status = previousDate
		? `snapshot ${snapshotDate}, compared with ${previousDate}`
		: `snapshot ${snapshotDate}, nothing earlier to compare with yet`;
}
---

<header class="mb-10">
	<h1
		class="flex items-center gap-3 font-pixel text-base leading-normal [text-shadow:3px_3px_0_var(--drop)] sm:gap-4 sm:text-2xl"
	>
		<PixelIcon art={icon} className={`size-[18px] shrink-0 sm:size-[27px] ${iconColor}`} />
		{title}
	</h1>
	<p class="mt-3 text-xl text-muted">
		&gt; {status}<span
			class="ml-1 inline-block h-[1em] w-[0.5em] translate-y-[0.15em] bg-muted motion-safe:animate-blink"
		></span>
	</p>
</header>
