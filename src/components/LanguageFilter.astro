---
import { LANGUAGE_PARAM } from '../constants/rankings';
import { STAR } from '../constants/sprites';
import type { LeaderboardRow } from '../lib/leaderboard';
import { languageIconSvg } from '../utils/languages';
import PixelIcon from './PixelIcon';

interface Props {
	rows: LeaderboardRow[];
	/** The ?language= value, lowercased, or null when showing all languages. */
	selected: string | null;
}

const { rows, selected } = Astro.props;

// One button per language in the ranking, most common first.
const counts = new Map<string, number>();
for (const { language } of rows) {
	if (language) counts.set(language, (counts.get(language) ?? 0) + 1);
}
const languages = [...counts.keys()].sort((a, b) => counts.get(b)! - counts.get(a)! || a.localeCompare(b));

const allHref = Astro.url.pathname;
const button =
	'pixel-frame pixel-press inline-flex shrink-0 items-center gap-2 bg-surface px-3 py-1 text-xl whitespace-nowrap [--px:2px] hover:bg-hover aria-[current=page]:bg-frame aria-[current=page]:text-on-frame';
---

<nav
	data-language-filter
	aria-label="Filter by language"
	class="-mx-4 mb-8 flex gap-4 overflow-x-auto px-4 pt-1 pb-3 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-1"
>
	<a href={allHref} data-language="" aria-current={selected === null ? 'page' : undefined} class={button}>
		<PixelIcon art={STAR} className="size-[18px] text-star" />
		All
	</a>
	{
		languages.map((language) => {
			const active = language.toLowerCase() === selected;
			const svg = languageIconSvg(language, 20);
			return (
				// Clicking the selected language again goes back to all languages.
				<a
					href={active ? allHref : `?${new URLSearchParams({ [LANGUAGE_PARAM]: language })}`}
					data-language={language}
					aria-current={active ? 'page' : undefined}
					title={active ? 'Show all languages' : undefined}
					class={button}
				>
					{svg && <Fragment set:html={svg} />}
					{language}
				</a>
			);
		})
	}
</nav>

<script>
	import { LANGUAGE_PARAM } from '../constants/rankings';
	import { matchesLanguage, selectedLanguage } from '../utils/language-filter';

	// The server renders the first view; after that, clicks filter the rows in place
	// (tr[data-language] in LeaderboardTable) and update the URL, without loading a new page.
	const filter = document.querySelector<HTMLElement>('[data-language-filter]')!;
	const links = filter.querySelectorAll<HTMLAnchorElement>('a[data-language]');
	const rows = document.querySelectorAll<HTMLElement>('tr[data-language]');
	const empty = document.querySelector<HTMLElement>('[data-filter-empty]')!;

	function show(selected: string | null) {
		for (const link of links) {
			const language = link.dataset.language!;
			const active = language ? language.toLowerCase() === selected : selected === null;
			if (active) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
			if (!language) continue;
			link.href = active ? location.pathname : `?${new URLSearchParams({ [LANGUAGE_PARAM]: language })}`;
			if (active) link.title = 'Show all languages';
			else link.removeAttribute('title');
		}
		let visible = 0;
		for (const row of rows) {
			row.hidden = !matchesLanguage(row.dataset.language || null, selected);
			if (!row.hidden) visible++;
		}
		empty.hidden = visible > 0;
	}

	const showFromUrl = () => show(selectedLanguage(new URLSearchParams(location.search)));

	filter.addEventListener('click', (event) => {
		const link = (event.target as Element).closest('a');
		// Leave ctrl/cmd/shift-clicks alone so a filter can open in a new tab.
		if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		event.preventDefault();
		history.pushState(null, '', link.href);
		showFromUrl();
	});
	window.addEventListener('popstate', showFromUrl);
</script>
