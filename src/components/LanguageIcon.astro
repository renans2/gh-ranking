---
import { languageIconSvg } from '../utils/languages';

interface Props {
	language: string | null;
}

const { language } = Astro.props;
const svg = language ? languageIconSvg(language, 30, language) : null;
---

{
	svg ? (
		<span class="inline-flex align-middle" title={language} set:html={svg} />
	) : (
		<span class="text-muted">{language ?? '—'}</span>
	)
}
